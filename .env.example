# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# Public URL of the app (used for auth redirects, links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data mode: "demo" runs entirely on in-memory demo data and needs no
# external credentials. "supabase" connects to a real Supabase project.
NEXT_PUBLIC_DATA_MODE=demo

# --- Supabase (required only when NEXT_PUBLIC_DATA_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, NEVER expose to the browser, NEVER
# reference from a Client Component or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (Anthropic) ---
# Leave empty to run the assistant, planner and question generator in
# their deterministic/demo fallback mode (no external calls, no cost).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Optional embeddings provider for semantic search over study material.
# Leave empty to use full-text search fallback only.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Limits ---
MAX_UPLOAD_SIZE_MB=20
AI_DAILY_REQUEST_LIMIT=50

# --- Web Push notifications (reminders) ---
# Leave empty to disable notifications entirely. Generate a pair with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notificaciones@nexo-personal-os.app
# Shared secret the daily reminders cron job must send as a Bearer token.
# Required in production (Vercel Cron) so the endpoint can't be triggered by
# anyone who guesses the URL.
CRON_SECRET=
