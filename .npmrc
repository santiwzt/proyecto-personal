# Disable pnpm's "minimum release age" supply-chain guard for this project.
# Several pinned dependencies here are intentionally on their latest,
# very-recently-published versions (see docs/decisions/0006 for why we pin
# specific tooling versions) — without this, `pnpm install` fails with
# ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION on any pnpm that enables the guard
# by default.
minimum-release-age=0
